# Visionnaire environment configuration
# Copy to .env and adjust for your machine. Do not commit .env.

# Client → server WebSocket URL
# Local:
# VISIONNAIRE_SERVER_URL=ws://localhost:8765
# Brev (example — use your mapped public address):
VISIONNAIRE_SERVER_URL=ws://global.prd.ga.run.brev.nvidia.com:61074

# Server bind address / port (Brev must listen on 0.0.0.0)
VISIONNAIRE_HOST=0.0.0.0
VISIONNAIRE_PORT=8765

# Client camera
VISIONNAIRE_CAMERA_INDEX=0
VISIONNAIRE_JPEG_QUALITY=80
VISIONNAIRE_TARGET_FPS=5

# Optional YOLO / decision tuning
# VISIONNAIRE_YOLO_MODEL=yolov8n.pt
# VISIONNAIRE_YOLO_CONF=0.45
# VISIONNAIRE_CRITICAL_HEIGHT_RATIO=0.45
# VISIONNAIRE_WARNING_HEIGHT_RATIO=0.25
# VISIONNAIRE_DECISION_COOLDOWN=2.0
